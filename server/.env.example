# Copy to .env and fill in. Names only here; never commit real values.

# Required: the bearer token the macOS app sends. Generate one: openssl rand -hex 32
ADS_PULSE_TOKEN=

# Optional: serve fake data, no ad credentials needed (1 = on).
ADS_PULSE_DEMO=
# Optional: cache seconds (default 300) and port for `npm start` (default 8787).
ADS_PULSE_CACHE_SECONDS=
PORT=

# Google Ads API: developer token + OAuth client + a refresh token with the adwords scope.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Your manager (MCC) account id, if your accounts sit under one.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: only these accounts get the login-customer-id header (default: every non-LSA account).
GOOGLE_ADS_MCC_CHILDREN=
# Comma-separated customer ids, each with an optional label, e.g. 1234567890:Search,2345678901:Brand
GOOGLE_ADS_ACCOUNTS=
# Local Services Ads accounts, same format (leads are counted as conversions).
GOOGLE_ADS_LSA_ACCOUNTS=
# Optional: Google Ads API version (default v24).
GOOGLE_ADS_API_VERSION=

# Apple Ads API (Apple Ads > Account Settings > API; an ES256 key pair you generate).
APPLE_ADS_CLIENT_ID=
APPLE_ADS_TEAM_ID=
APPLE_ADS_KEY_ID=
APPLE_ADS_ORG_ID=
APPLE_ADS_LABEL=
# The PEM private key itself (\n escapes are fine), or a path to the .pem file.
APPLE_ADS_PRIVATE_KEY=
APPLE_ADS_PRIVATE_KEY_PATH=

# ChatGPT Ads reporting API (optional).
OPENAI_ADS_API_KEY=
OPENAI_ADS_LABEL=
OPENAI_ADS_TIME_ZONE=
